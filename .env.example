DATABASE_URL=
# TLS avec vérification du serveur : sslmode=verify-full dans DATABASE_URL.
# Pour reproduire le mode libpq require sans vérification du certificat :
# sslmode=require&uselibpqcompat=true (connexion chiffrée, identité du serveur non vérifiée).
# Pour vérifier une CA privée, indiquer le chemin absolu vers son certificat PEM.
PG_SSL_CA_FILE=
BETTER_AUTH_SECRET=
# En développement, localhost et les adresses de bouclage sont acceptés sur le même port.
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Client OAuth Google de type Application Web ; valeurs serveur uniquement.
# URI de retour : http://localhost:3000/api/auth/callback/google
# Ajouter un autre hôte dans Google Cloud uniquement si vous l’utilisez pour OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Valeurs générées par npm run setup, conservées localement.
DEMO_OWNER_EMAIL=organisateur@tournio.test
DEMO_OWNER_PASSWORD=
DEMO_OTHER_EMAIL=autre@tournio.test
DEMO_OTHER_PASSWORD=
