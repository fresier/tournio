{
  "name": "tournio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:status": "node scripts/prisma.mjs migrate status",
    "test:seed": "node --import tsx scripts/test-seed.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx scripts/check-business.ts",
    "test:realtime": "node --import tsx scripts/check-realtime.ts",
    "test:google": "node --import tsx scripts/check-google.ts",
    "test:local": "node scripts/test-local.mjs",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
